# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="https://YOUR_PROJECT.vercel.app"

# SUPABASE CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL="https://nqghrhbgoeyhiilnhjlx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# TWILIO TELEPHONY CONFIGURATION (TEST / PRODUCTION)
NEXT_PUBLIC_TWILIO_ACCOUNT_SID="AC_TEST_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+15550192834"
